# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values are bundled into the app —
# they are public by design. NEVER put the service-role key or payment secrets here.

# Supabase project (Settings → API). Leave empty to run fully offline in guest mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public links shown in the app and required by the stores
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_WEB_URL=https://play.example.com

# ---------------------------------------------------------------------------
# Server-side secrets — set with `npx supabase secrets set KEY=value`, NOT here:
#   SUPABASE_SERVICE_ROLE_KEY   (provided automatically to Edge Functions)
#   REVENUECAT_WEBHOOK_SECRET   (billing-webhook)
#   ALLOWED_ORIGIN              (optional CORS origin for Edge Functions, e.g. https://play.example.com)
